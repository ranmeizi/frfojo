# boss publish / pull / use
BOSS_PROJECT=bobo-tool

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=

# ── 本地 publish：长期 AccessKey ──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── ECS 上 pull / use：推荐 STS（实例 RAM 角色）──
# OSS_AUTH=ecs
# OSS_ECS_RAM_ROLE=你的实例角色名
# （可不写 OSS_ACCESS_KEY_*；会从 10.10.10.10 元数据自动取 STS）
# 测试: pnpm boss -- ram-test

# ── 或手动传入已有 STS Token（配合临时 AK/SK）──
# OSS_STS_TOKEN=
# OSS_SECURITY_TOKEN=   # 与 OSS_STS_TOKEN 等价

# 可选
# OSS_PREFIX=
# OSS_ENDPOINT=
# OSS_PUBLIC_BASE_URL=
# BOSS_CACHE_DIR=.boss   # pull 本地缓存（已 gitignore）
# BOSS_DIR=./dist        # use 解压覆盖目录
# OSS_REFRESH_STS_INTERVAL=300000
